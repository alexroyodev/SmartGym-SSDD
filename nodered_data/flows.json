    {
        "id": "35967bb691e51a53",
        "type": "function",
        "z": "243786f0c673f8a7",
        "name": "Actualizar aforo",
        "func": "// Recuperamos el aforo actual de la memoria de Node-RED (empieza en 0)\nlet aforo = context.get('aforoActual') || 0;\n\n// Analizamos la dirección del mensaje MQTT\nif (msg.payload.direccion === \"entrada\") {\n    aforo += 1;\n} else if (msg.payload.direccion === \"salida\") {\n    // Evitamos que el aforo sea negativo si sale alguien sin haber entrado en el simulador\n    aforo = Math.max(0, aforo - 1);\n}\n\n// Guardamos el nuevo valor en memoria\ncontext.set('aforoActual', aforo);\n\n// Sobrescribimos el payload para que el panel visual solo reciba el número final\nmsg.payload = aforo;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 460,
        "wires": [
