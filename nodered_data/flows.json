    {
        "id": "2a405df88a83b73c",
        "type": "function",
        "z": "243786f0c673f8a7",
        "name": "Seleccionar latidos",
        "func": "// Recuperamos qué usuario está seleccionado en el desplegable\nlet seleccionado = flow.get('usuarioActivo');\n\n// Si acaba de arrancar y no has tocado el desplegable, forzamos uno por defecto\nif (!seleccionado) {\n    seleccionado = \"u101\";\n}\n\n// Si el mensaje es del usuario seleccionado, pasamos solo sus pulsaciones\nif (msg.payload.id_usuario === seleccionado) {\n    msg.payload = msg.payload.pulsaciones;\n    return msg;\n}\n\n// Si es de otro usuario, destruimos el mensaje devolviendo null\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 160,
        "wires": [
            [
                "b30d559b5291977d"
            ]
        ]
    },
    {
        "id": "17e3cc4c83fee13f",
        "type": "function",
        "z": "243786f0c673f8a7",
        "name": "Detector usuarios nuevos",
        "func": "// Memoria interna para guardar los usuarios que vamos descubriendo\nlet usuariosConocidos = context.get('listaUsuarios') || [];\nlet nuevoUsuario = msg.payload.id_usuario;\n\n// Si llega un ID que no está en nuestra lista, lo registramos\nif (!usuariosConocidos.includes(nuevoUsuario)) {\n    usuariosConocidos.push(nuevoUsuario);\n    context.set('listaUsuarios', usuariosConocidos);\n    \n    // Le inyectamos la lista actualizada al desplegable\n    msg.options = usuariosConocidos;\n    return msg; \n}\n\n// Si el usuario ya era conocido, cortamos el flujo aquí para no saturar el desplegable\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
